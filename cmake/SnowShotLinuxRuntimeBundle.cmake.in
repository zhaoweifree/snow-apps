# Bundles the project's own shared libraries into the Linux package.
#
# Executed as an install rule, i.e. after the install rules above it have filled
# the staging tree and before the archive is built. The tree is reached through
# `$ENV{DESTDIR}` (CPack's mechanism), not through `CMAKE_INSTALL_PREFIX`.
#
# Why this exists at all: the pinned dependencies in
# `scripts/build-linux-deps.sh` are *self-built* -- pinned versions that no
# distribution package provides (libjxl 0.11, OpenEXR 3.4, Imath 3.2,
# libjpeg-turbo 3, lunasvg 3). `CPACK_DEBIAN_PACKAGE_SHLIBDEPS=ON` asks
# `dpkg-shlibdeps` to derive `Depends:` from the ELF NEEDED entries, and a
# shared library that belongs to no installed package makes that step fail:
#
#     dpkg-shlibdeps: error: cannot find library libjxl.so.0.11 needed by ...
#
# Shipping them is the only answer that leaves a package which starts on a
# machine that has neither the build prefix nor those versions. The
# alternatives were rejected in the port document: a hand-written `Depends:`
# goes stale silently, and `SHLIBDEPS=OFF` produces a package that installs and
# then dies at startup.
#
# The set is computed, not listed. `file(GET_RUNTIME_DEPENDENCIES)` walks the
# already-staged ELF objects and resolves them against the dependency prefix,
# which yields the *transitive* closure -- `libjxl` alone would not be enough,
# because `libjxl` itself needs `libhwy`, and a hand-maintained list would have
# to be corrected on the next run. Everything resolved from the dependency
# prefix is private; everything else (glibc, Qt, FFmpeg, X11) stays a
# `dpkg-shlibdeps` dependency, which is what makes the package installable at
# all.
#
# `RPATH` is what ties the two halves together. Both the staged executables and
# the libraries copied here have to carry `$ORIGIN/../lib` / `$ORIGIN`:
#
#   * the loader uses it to find the private copies at run time;
#   * `CPackDeb.cmake` scans each binary's RUNPATH for `$ORIGIN` and turns every
#     hit into `-l<dir>` for `dpkg-shlibdeps`, which is the only way
#     `dpkg-shlibdeps` learns that these sonames are already inside the package.
#
# `DT_RUNPATH` is not inherited by an indirect dependency, so the bundled
# libraries need their own `$ORIGIN` -- an executable's RUNPATH would only cover
# its direct dependencies.

cmake_minimum_required(VERSION 3.21)

# Two callers, one script:
#
#   * the .deb: `install(SCRIPT ...)` in SnowShotLinuxPackage.cmake, run by
#     `cmake_install.cmake` with `DESTDIR` pointing at the tree CPack asked for
#     and `CMAKE_INSTALL_PREFIX` at the prefix *inside* the package;
#   * the `snow-shot-appimage` target, by hand, with `-DSTAGED_DIR=` on the
#     install prefix it just filled (`cmake --install` never runs CPack, and
#     CPack never runs for the AppImage).
#
# It used to hang off `CPACK_INSTALL_SCRIPTS`. Run 38 showed what that hook
# actually is: CPack executes those scripts *before* installing the project, so
# this script found an empty tree and refused with "the staged tree has no ELF
# objects". An install rule, besides running after the rules above it, also runs
# for the AppImage's `cmake --install` -- which is the other half of why the
# AppDir used to hold no shared library at all.
# The staging tree is *not* `CMAKE_INSTALL_PREFIX`. Under CPack the prefix is the
# packaging prefix (`CPACK_PACKAGING_INSTALL_PREFIX`, `/usr` here) and the tree
# CPack fills is reached through the DESTDIR mechanism -- every generated install
# rule applies `$ENV{DESTDIR}` to its destination, and an install script has to
# do the same. Reading the prefix alone pointed this script at the *host*
# `/usr/bin`: 3000 entries, and the loop below handed `file(READ)` a 43 KB
# "file name" (run 39). It also would have bundled the build machine's
# libraries had the loop survived.
#
# An empty DESTDIR together with the packaging prefix is refused rather than
# degraded to the prefix: that combination means the caller is not staging
# anything, and reading `/usr` as if it were a package tree is never right.
if(DEFINED STAGED_DIR AND NOT STAGED_DIR STREQUAL "")
    set(_staged "${STAGED_DIR}")
elseif(DEFINED ENV{DESTDIR} AND NOT "$ENV{DESTDIR}" STREQUAL "")
    set(_staged "$ENV{DESTDIR}${CMAKE_INSTALL_PREFIX}")
elseif(DEFINED CMAKE_INSTALL_PREFIX AND NOT CMAKE_INSTALL_PREFIX STREQUAL ""
        AND NOT CMAKE_INSTALL_PREFIX MATCHES "^@SNOW_SHOT_LINUX_PACKAGE_PREFIX@/?$")
    # CPack has been seen to point the prefix straight at the staging tree. Take
    # that when it happens, but never when the prefix is the packaging prefix.
    set(_staged "${CMAKE_INSTALL_PREFIX}")
else()
    message(FATAL_ERROR
        "snow-shot bundle script: there is no staging tree. DESTDIR is empty and "
        "CMAKE_INSTALL_PREFIX is '@SNOW_SHOT_LINUX_PACKAGE_PREFIX@', which is the "
        "prefix inside the package, not a directory on this machine. Run this "
        "through CPack (it sets DESTDIR), or pass -DSTAGED_DIR=<install prefix>.")
endif()

set(_private_lib_dir "@SNOW_SHOT_LINUX_PRIVATE_LIB_DIR@")
set(_deps_lib_dir "@SNOW_SHOT_LINUX_DEPS_LIB_DIR@")
set(_lib_subdir "@SNOW_SHOT_LINUX_INSTALL_LIBDIR@")

if(NOT _deps_lib_dir OR NOT IS_DIRECTORY "${_deps_lib_dir}")
    message(FATAL_ERROR
        "snow-shot bundle script: the dependency prefix is not a directory: "
        "'${_deps_lib_dir}'. Configure with CMAKE_PREFIX_PATH pointing at the "
        "prefix scripts/build-linux-deps.sh installed into.")
endif()

# Everything CPack is about to package, discovered rather than listed: a
# hardcoded list of binaries would have to grow every time an executable is
# installed, and forgetting one means its dependencies are never resolved -- the
# library it needs is then missing from the package and `dpkg-shlibdeps` reports
# it as an error three steps later, with no hint about the cause.
#
# `usr/bin` also holds helper scripts in some configurations, and
# `file(GET_RUNTIME_DEPENDENCIES)` aborts on a non-ELF input, so the magic is
# checked first.
#
# The existence check inside the helper is not redundant with the glob. When one
# of the matches is named `[`, `file(GLOB)` returns a single element whose value
# still contains the list separators (measured on CMake 4.2: the two files `[`
# and `aa` give `list(LENGTH)` = 1 and a value that prints as `…/[...;/…/aa`).
# `foreach(IN LISTS)` then runs once with the whole string, `file(READ)` fails
# with `(File name too long)` -- naming no file at all -- and the 43 KB line it
# prints buries the cause. Checking every entry turns that into one sentence.
function(_snow_staged_paths out_var)
    file(GLOB _entries LIST_DIRECTORIES false ${ARGN})
    foreach(_entry IN LISTS _entries)
        if(NOT EXISTS "${_entry}")
            string(LENGTH "${_entry}" _entry_length)
            string(SUBSTRING "${_entry}" 0 80 _entry_head)
            message(FATAL_ERROR
                "snow-shot bundle script: a glob result is not a file: "
                "${_entry_length} characters starting with '${_entry_head}'. "
                "`file(GLOB)` collapses its result into one element when a match "
                "is named '[', and the pattern was: ${ARGN}")
        endif()
    endforeach()
    set(${out_var} "${_entries}" PARENT_SCOPE)
endfunction()

set(_executables "")
_snow_staged_paths(_staged_programs "${_staged}/@SNOW_SHOT_LINUX_INSTALL_BINDIR@/*")
foreach(_program IN LISTS _staged_programs)
    file(READ "${_program}" _magic OFFSET 0 LIMIT 4 HEX)
    if(_magic STREQUAL "7f454c46")
        list(APPEND _executables "${_program}")
    endif()
endforeach()

_snow_staged_paths(_staged_libraries "${_staged}/${_lib_subdir}/*.so*")

if(NOT _executables AND NOT _staged_libraries)
    message(FATAL_ERROR "snow-shot bundle script: the staged tree has no ELF objects.")
endif()

# `DIRECTORIES` is the only place the solver may look for the private copies;
# the default search path is still consulted for system libraries.
file(GET_RUNTIME_DEPENDENCIES
    EXECUTABLES ${_executables}
    LIBRARIES ${_staged_libraries}
    RESOLVED_DEPENDENCIES_VAR _resolved
    UNRESOLVED_DEPENDENCIES_VAR _unresolved
    DIRECTORIES "${_deps_lib_dir}")

get_filename_component(_deps_real "${_deps_lib_dir}" REALPATH)

set(_bundled "")
foreach(_dependency IN LISTS _resolved)
    get_filename_component(_real "${_dependency}" REALPATH)
    get_filename_component(_dir "${_real}" DIRECTORY)
    if(NOT _dir STREQUAL _deps_real)
        continue()
    endif()
    # The name to ship under is the one the *loader asks for*, not the one the
    # file happens to have. A dependency prefix installs `libjxl.so.0.11` as a
    # symlink to `libjxl.so.0.11.0`, and `GET_RUNTIME_DEPENDENCIES` resolves the
    # NEEDED soname, so the entry above carries `libjxl.so.0.11` while its
    # `REALPATH` carries the version. Copying the real file under its own name
    # puts `libjxl.so.0.11.0` in the package, and both the loader and
    # `dpkg-shlibdeps` keep looking for `libjxl.so.0.11` -- a package that
    # installs and then dies with "cannot open shared object file".
    get_filename_component(_soname "${_dependency}" NAME)
    get_filename_component(_real_name "${_real}" NAME)
    set(_private_dir "${_staged}/${_private_lib_dir}")
    set(_destination "${_private_dir}/${_soname}")
    if(NOT EXISTS "${_destination}")
        file(COPY "${_real}" DESTINATION "${_private_dir}"
             FILE_PERMISSIONS OWNER_READ OWNER_WRITE OWNER_EXECUTE
                              GROUP_READ GROUP_EXECUTE WORLD_READ WORLD_EXECUTE)
        if(NOT _real_name STREQUAL _soname)
            file(RENAME "${_private_dir}/${_real_name}" "${_destination}")
        endif()
    endif()
    # Appended even when the file was already there: the RPATH loop below has to
    # cover every private library present, not only the ones this run copied.
    list(APPEND _bundled "${_destination}")
endforeach()

# A private copy is useless if the loader cannot find it, and a bundled library
# that needs another bundled library is exactly the case `DT_RUNPATH` does not
# cover for its parent.
#
# `file(RPATH_SET)` takes keyword arguments (`FILE` / `NEW_RPATH`); the
# positional form `file(RPATH_SET <file> <rpath>)` is a *different* sub-command
# signature and CMake rejects it at CPack time with "unrecognized argument".
if(_bundled)
    foreach(_library IN LISTS _bundled)
        file(RPATH_SET FILE "${_library}" NEW_RPATH "$ORIGIN")
    endforeach()
endif()

# Only report what this run actually did. A bare "ok" hides both an empty
# closure and a library that silently stopped being private.
list(LENGTH _resolved _resolved_count)
list(LENGTH _unresolved _unresolved_count)
message(STATUS "snow-shot bundle: ${_resolved_count} resolved dependency file(s), "
               "${_unresolved_count} unresolved")
message(STATUS "snow-shot bundle: private libraries (${_private_lib_dir})")
foreach(_library IN LISTS _bundled)
    get_filename_component(_name "${_library}" NAME)
    message(STATUS "snow-shot bundle:   ${_name}")
endforeach()
if(NOT _bundled)
    message(WARNING
        "snow-shot bundle: nothing was bundled. Either every dependency is a "
        "distribution package, or the dependency prefix is wrong -- "
        "dpkg-shlibdeps will say which one.")
endif()

# An unresolved dependency is not fatal here: `dpkg-shlibdeps` decides, and it
# has the shlibs database this script does not. Printing them is what makes the
# next failure readable instead of mysterious.
foreach(_missing IN LISTS _unresolved)
    message(STATUS "snow-shot bundle: unresolved ${_missing}")
endforeach()
